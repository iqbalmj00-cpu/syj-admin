}

// ── Sprint 3: Post-Job Checklist ──────────────────────────────────────────────

model ChecklistItem {
  id          String    @id @default(cuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  label       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  sortOrder   Int       @default(0)

  @@index([jobId])
}

// ── Sprint 3: Customer Communications ─────────────────────────────────────────

model Communication {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel    String   @default("email") // email | sms | phone | note
  direction  String   @default("outbound") // inbound | outbound
  subject    String?
  body       String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([userId, customerId])
}

// ── Sprint 7: Follow-Up Tasks ─────────────────────────────────────────────────

model FollowUpTask {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  jobId       String?
  job         Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  title       String
  dueAt       DateTime
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, dueAt])
}

// 8I — Tax Configuration
model TaxRate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String // "TX Sales Tax", "CA State Tax"
  rate      Float // 0.0825 = 8.25%
  region    String? // "TX", "CA", etc.
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  jobId     String?

  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// 19-Feature Plan: New Models
// ═══════════════════════════════════════════════════════════════════════════════

// ── F11: Staff weekly availability ──
model StaffSchedule {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffId   String
  staff     Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dayOfWeek Int    // 0=Sun, 1=Mon ... 6=Sat
  startTime String // "08:00"
  endTime   String // "17:00"

  @@unique([staffId, dayOfWeek])
  @@index([userId])
}

// ── F11: Staff time-off requests ──
model StaffTimeOff {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([staffId, startDate])
  @@index([userId])
}

// ── F14: Per-job crew assignments ──
model JobCrewAssignment {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  role      String   @default("laborer") // driver | laborer | foreman
  createdAt DateTime @default(now())

  @@unique([jobId, staffId])
  @@index([staffId])
}

// ── F16: Maintenance log per truck ──
model MaintenanceRecord {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  truckId        String?
  truck          Truck?     @relation(fields: [truckId], references: [id], onDelete: Cascade)
  // ── Dumpster Rental addition ──
  containerId    String? // optional: maintenance for a container instead of truck
  container      Container? @relation(fields: [containerId], references: [id], onDelete: Cascade)
  type           String   // oil_change | tire_rotation | brake_service | inspection | repair | other
  description    String?  @db.Text
  cost           Float?   // dollars
  mileageAt      Int?     // odometer at time of service
  performedAt    DateTime @default(now())
  nextDueDate    DateTime?
  nextDueMileage Int?
  vendor         String?
  receiptUrl     String?
  createdAt      DateTime @default(now())

  @@index([truckId, performedAt])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Onboarding Wizard Models
// ═══════════════════════════════════════════════════════════════════════════════

model WebsiteConfig {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subdomain       String    @unique             // e.g. "bobs-junk-removal"
  brandColor      String    @default("#FF6B00")
  logoUrl         String?
  heroImageUrl    String?
  logoPrompt      String?   @db.Text            // AI image gen prompt for logo
  heroPrompt      String?   @db.Text            // AI image gen prompt for hero image
  theme           String    @default("classic") // classic | industrial | eco | editorial
  pricingConfig   Json?                         // { truckSize, fullLoadPrice, tiers, surcharges }
  tagline         String?
  services        String[]                      // selected service slugs
  testimonials    Json?                         // [{name, body, rating}]
  imageGenProgress Json?                        // { completed: string[], total: number, urls: {}, retries: {} }
  gaTrackingId    String?
  vercelProjectId String?
  deployStatus    String    @default("pending") // pending | building | live | error
  websiteUrl      String?                       // final public URL once live
