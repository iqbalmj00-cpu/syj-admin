  evidenceType      String   // payment | refund | comp | dispute | other
  status            String   @default("recorded") // recorded | verified | rejected
  amountCents       Int?
  currency          String   @default("usd")
  externalReference String?
  note              String   @db.Text
  occurredAt        DateTime
  recordedBy        String
  createdAt         DateTime @default(now())

  @@index([customerLinkId, occurredAt])
  @@index([opportunityId, occurredAt])
  @@index([evidenceType, status, occurredAt])
}

model ColdEmailBlackoutDate {
