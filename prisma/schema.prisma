// Dumpster Rental Module Models
// ═══════════════════════════════════════════════════════════════════════════════

model Container {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String              // "D-001", "D-003"
  sizeCuYd        Int                 // 10 | 15 | 20 | 30 | 40
  status          String              @default("available") // available | rented | in_transit | reserved | out_of_service
  currentLocation String              @default("yard") // "yard" or customer address
  homeAddress     String?             // optional per-container home/storage address
  homeLat         Float?
  homeLng         Float?
  currentRentalId String?             // FK when rented
  lat             Float?
  lng             Float?
  isFull          Boolean             @default(false)
  lastServicedAt  DateTime?
  yardReturnedAt  DateTime?
  notes           String?             @db.Text
  rentals         RentalContainerHistory[]
  maintenanceRecords MaintenanceRecord[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([userId, status])
  @@index([userId, sizeCuYd, status])
}

model Rental {
  id                  String              @id @default(cuid())
  userId              String
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  rentalNumber        Int                 // auto-increment per user (R-001, R-002)
  customerId          String
  customer            Customer            @relation(fields: [customerId], references: [id])
  containerId         String?             // current container on-site
  status              String              @default("booked") // booked | delivered | active | pickup_scheduled | picked_up | pending_weight | completed | cancelled
  deliveryAddress     String
  debrisType          String              @default("mixed")
  rentalType          String              @default("fixed") // fixed | call_when_ready
  baseRate            Float
  includedDays        Int                 @default(7)
  weightAllowanceTons Float?
  overageRatePerTon   Float?
  extendedDailyRate   Float?
  swapOutFee          Float               @default(0)
  totalOverage        Float               @default(0)
  swapOutCount        Int                 @default(0)
  collectOnDelivery   Boolean             @default(true)
  pickupReminderSentAt DateTime?
  deliveryDate        DateTime?
  deliveredAt         DateTime?
  pickupScheduledAt   DateTime?
  pickedUpAt          DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?
  notes               String?             @db.Text
  deliveryPhotoUrl    String?
  signatureUrl        String?
  containerHistory    RentalContainerHistory[]
  jobs                Job[]               @relation("RentalJobs")
  invoices            Invoice[]           @relation("RentalInvoices")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([userId, status])
  @@index([customerId])
}

model RentalContainerHistory {
  id                String    @id @default(cuid())
  rentalId          String
  rental            Rental    @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  containerId       String
  container         Container @relation(fields: [containerId], references: [id], onDelete: Cascade)
  startedAt         DateTime  @default(now())
  endedAt           DateTime?
  dumpTicketId      String?
  conditionOnReturn String?

  @@index([rentalId])
  @@index([containerId])
}

model DumpsterPriceTier {
  id                  String @id @default(cuid())
  userId              String
  user                User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sizeCuYd            Int    // 10 | 15 | 20 | 30 | 40
  baseRate            Float
  baseRateMin         Float?
  baseRateMax         Float?
  includedDays        Int    @default(7)
  weightAllowanceTons Float
  overageRatePerTon   Float
  extendedDailyRate   Float?

  @@unique([userId, sizeCuYd])
}

model DumpsterSurcharge {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String  // "Delivery beyond 15 miles", "Roofing debris"
  type   String  @default("debris") // debris | distance | swap
  amount Float
  active Boolean @default(true)

  @@index([userId])
}

