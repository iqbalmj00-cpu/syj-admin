  agentRun     SyjAgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  contentType  String
  feature      String
  platform     String
  title        String
  script       Json
  voiceoverUrl String?
  videoUrl     String?
  thumbnailUrl String?
  duration     Int      @default(0)
  status       String   @default("rendering")
  createdAt    DateTime @default(now())

  @@index([status])
  @@index([contentType])
}

model OutreachQueue {
  id           String    @id @default(cuid())
  leadId       String
  lead         ScrapedLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel      String    @default("email")  // email | sms
