model PhoneConfig {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber String                            // E.164, e.g. +12145550100
  twilioSid   String                            // Twilio phone number SID
  areaCode    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── AI Agents ───────────────────────────────────────────────────────────────

model SyjAgent {
  id          String      @id @default(cuid())
  slug        String      @unique       // "lead_scraper" | "cold_outreach" | "content_generator" | "blog_writer"
  name        String                    // "Lead Scraper"
  description String?     @db.Text
  status      String      @default("idle") // idle | running | error | paused
  schedule    String?                   // cron expression or null for manual-only
  config      Json?                     // agent-specific config (markets, templates, etc.)
  lastRunAt   DateTime?
  lastError   String?     @db.Text
  enabled     Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  runs        SyjAgentRun[]
}

model SyjAgentRun {
  id          String       @id @default(cuid())
  agentId     String
  agent       SyjAgent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  status      String       @default("running") // running | completed | failed | cancelled
  trigger     String       @default("manual")  // manual | scheduled | chained
  config      Json?                            // snapshot of config at run time
  results     Json?                            // agent-specific results summary
  error       String?      @db.Text
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  durationMs  Int?
  leads       ScrapedLead[]
  blogPosts   BlogPost[]
  generatedContent GeneratedContent[]
  researchReports  ResearchReport[]

  @@index([agentId, startedAt])
}

model ScrapedLead {
  id              String       @id @default(cuid())
  agentRunId      String?
  agentRun        SyjAgentRun? @relation(fields: [agentRunId], references: [id])
  // ── Company info ──
  name            String
  phone           String?
  email           String?
  website         String?
  address         String?
  city            String?
  state           String?      // 2-letter US state code (e.g. "TX") — parsed from address at enrichment time for TCPA filtering
  market          String
  source          String       @default("google") // google | yelp | both
  categories      String[]
  // ── Ratings ──
  rating          Float?
  reviewCount     Int?
  googlePlaceId   String?      @unique
  googleMapsUrl   String?
  yelpUrl         String?
  // ── Enrichment ──
  hasOnlineBooking Boolean     @default(false)           // LEGACY / backward-compat: mirrors hasTrueOnlineBooking
  hasTrueOnlineBooking Boolean @default(false)           // Tier 1-3 — real self-service booking (embed, external link, or native form)
  hasBookingCta   Boolean      @default(false)           // Page has "Book Now" text/button (may be marketing-only)
  bookingPlatform String?                                // "Calendly" | "Jobber" | "Housecall Pro" | "Custom (native form)" | etc.
  bookingType     String?                                // "embed" | "external_link" | "native_form" | "cta_only" | "none"
  bookingCtaTargetsPhone Boolean @default(false)         // "Book Now" button href is a tel: link (misleading CTA)
  bookingHasPhotoUpload Boolean @default(false)          // Booking flow accepts photo uploads (customer sends pics of junk)
  bookingHasTimeslotSelection Boolean @default(false)    // Booking flow has date/time slot picker
  bookingFlowType String?                                // "photo_upload" | "timeslot_selection" | "photo_and_timeslot" | "other" | null
  // ── Granular booking-flow components (Phase 2.5) ──
  bookingHasAddressInput     Boolean   @default(false)   // asks customer for service address
  bookingHasJobSizeInput     Boolean   @default(false)   // volume / truck-size / quantity estimator
  bookingHasItemSelector     Boolean   @default(false)   // checklist of item types (sofa, fridge, etc.)
  bookingHasInstantQuote     Boolean   @default(false)   // shows real-time price BEFORE confirming
  bookingHasPriceEstimate    Boolean   @default(false)   // rough ballpark pricing shown (range)
  bookingCollectsPayment     Boolean   @default(false)   // asks for card / deposit upfront
  bookingIsQuoteRequestOnly  Boolean   @default(false)   // form goes to manual quote (no instant anything)
  bookingSophistication      String?                     // "none" | "cta_only" | "basic_scheduler" | "photo_collector" | "quote_form" | "instant_quote" | "full_booking" | "other"
  hasQuoteForm    Boolean      @default(false)
  hasCta          Boolean      @default(false)
  mobileFriendly  Boolean      @default(true)
  sslValid        Boolean      @default(true)
  loadTimeSeconds Float?
  techDetected    String[]
  socialLinks     Json?
  contactPageUrl  String?
  smsMentioned    Boolean      @default(false)
  ownerName       String?
  notesFlags      String[]
  // ── Classification ──
  companyType     String       @default("junk_removal") // junk_removal | dumpster_rental | demolition | other
  // ── Enrichment Agent fields ──
  serviceTypes         String[]                  // ["junk_removal", "dumpster_rental"] — more granular than companyType
  phoneType            String?                   // "toll_free" | "local" | "none"
  // ── Enrichment v2 contract + evidence ──
  enrichmentVersion       String?
  enrichmentRunId         String?
  enrichmentEvidence      Json?
  enrichmentCompleteness  Json?
  contactStatus           String?                // "checked" | "not_found" | "unknown"
  ownerStatus             String?                // "confirmed" | "possible" | "not_found" | "unknown"
  bookingStatus           String?                // "confirmed" | "cta_only" | "not_found" | "unknown"
  pricingStatus           String?                // "realtime" | "static" | "estimate" | "not_found" | "unknown"
  serviceAreaStatus       String?                // "confirmed" | "partial" | "not_found" | "unknown"
  primaryCtaText          String?   @db.Text
  primaryCtaHref          String?
  primaryCtaType          String?                // "phone" | "quote" | "booking" | "contact" | "other"
  primaryCtaEvidence      Json?
  ctaPromiseTags          String[]  @default([]) // "same_day" | "24_7" | "free_estimate" | etc.
  leadHandlingPromiseTags String[]  @default([])
  leadHandlingPromises    Json?
  bookingProcessSummary   String?   @db.Text
  bookingProcessSteps     Json?
  bookingProcessUrl       String?
  bookingEvidence         Json?
  realTimePricingVisible  Boolean?
  pricingEvidence         Json?
  offersDumpsterRental    Boolean?
  offersJunkRemoval       Boolean?
  serviceMixConfidence    String?                // "high" | "medium" | "low" | "unknown"
  serviceMixEvidence      Json?
  ownerNameConfidence     String?                // "high" | "medium" | "low" | "unknown"
  ownerNameEvidence       Json?
  emailSource             String?
  emailConfidence         String?                // "high" | "medium" | "low" | "unknown"
  serviceAreaEvidence     Json?
  hasPhotos               Boolean?
  googlePhotosEvidence    Json?
  lowStarComplaintSummary String?   @db.Text
  lowStarComplaintTags    String[]  @default([])
  lowStarReviewExcerpts   Json?
  mixedStarReviewSummary  String?   @db.Text
  googleAdsStatus         String?                // "confirmed_current" | "confirmed_recent" | "tag_detected_only" | "not_found" | "unknown"
  googleAdsEvidence       Json?
  googleAdsLastCheckedAt  DateTime?
  payOnlinePresent        Boolean?
  payOnlineHref           String?
  payInvoicePresent       Boolean?
  payInvoiceHref          String?
  paymentEvidence         Json?
  operatingHours          Json?
  operatingHoursSource    String?                // "gbp" | "website" | "unknown"
  estimatedFleetSizeConfidence    String?
  estimatedEmployeesConfidence    String?
  yearsInBusinessConfidence       String?
  scaleEvidence           Json?
  hasActiveWebsite     Boolean   @default(false) // URL responds with 200
  usingCompetitor      Boolean   @default(false) // on competitor platform (Jobber, Workiz, etc.)
  competitorPlatform   String?                   // "Jobber" | "Workiz" | "Housecall Pro" etc (free-text display; prefer per-platform booleans below for filtering)
  // ── Per-platform booleans (Phase 3) ──
  usesJobber           Boolean   @default(false)
  usesWorkiz           Boolean   @default(false)
  usesHousecallPro     Boolean   @default(false)
  usesServiceTitan     Boolean   @default(false)
  usesThryv            Boolean   @default(false)
  usesGorillaDesk      Boolean   @default(false)
  usesFieldPulse       Boolean   @default(false)
  usesQuoteIQ          Boolean   @default(false)
  usesDocket           Boolean   @default(false)
  usesDumpstersCom     Boolean   @default(false) // Dumpsters.com partnership / lead-gen referral
  // ── Payment stack (Phase 3) ──
  usesStripe           Boolean   @default(false)
  usesSquare           Boolean   @default(false)
  mentionsCashOnly     Boolean   @default(false) // "cash only" / "cash or check" mentioned on site
  hasOnlinePayment     Boolean   @default(false) // derived: usesStripe || usesSquare || hasTrueOnlineBooking
  paymentPlatform      String?                   // free-text display (e.g. "Stripe", "Square", "Stripe + Square")
  // ── Website crawl depth (Phase 6) ──
  lastUpdatedYear              Int?               // from copyright footer (© 20\d{2}) OR latest blog post date
  hasPricingPage               Boolean   @default(false)
  pricingSnippet               String?   @db.Text // short sample text found on pricing page
  hasBlog                      Boolean   @default(false)
  serviceAreaPagesCount        Int?               // count of /service-area/, /locations/, /areas-we-serve/ pages from sitemap
  hasServiceAreaPublishedOnSite Boolean  @default(false) // distinct from serviceAreaCities (which comes from Google Places)
  totalPageCount               Int?               // total URLs in sitemap.xml
  // ── Personalization derivations (HIGH-impact Round 7) ──
  topNegativeReviewExcerpt     String?   @db.Text   // curated verbatim quote from the lowest-rated recent review (≤ 280 chars)
  topPraiseReviewExcerpt       String?   @db.Text   // curated verbatim positive quote (≤ 280 chars)
  daysSinceLastReview          Int?                  // computed at enrichment time from lastReviewDate
  daysSinceLastOwnerResponse   Int?                  // computed from lastOwnerResponseDate
  daysSinceMostRecentNegative  Int?                  // computed from mostRecentNegativeReviewDate
  employeeSizeBucket           String?               // "solo" | "small" | "growing" | "established" | "unknown"
  fleetSizeBucket              String?               // "1" | "2-5" | "6+" | "unknown"
  yearsInBusinessBucket        String?               // "<1" | "1-5" | "5-10" | "10+" | "unknown"
  websiteAgeYears              Int?                  // currentYear - lastUpdatedYear
  primaryBottleneck            String?               // "missed_calls" | "no_online_booking" | "poor_response_rate" | "outdated_website" | "no_reviews" | "stale_reviews" | "negative_review_trend" | "none"
  // ── Round 8: severity + trend + specialty ──
  painSeverityScore            Int?                  // 0-100 weighted severity from painTagCount + negativeReviewPercent + response inverse + recency
  businessSpecialty            String?   @db.Text    // Claude-extracted one-line angle (what makes this operator distinct)
  recentReviewTrend            String?               // "improving" | "stable" | "declining" | "dormant" | "insufficient_data"
  seoScore             Int?                      // 0-100
  uiuxScore            Int?                      // 0-100
  estimatedEmployees   Int?                      // from about/team page
  estimatedFleetSize   Int?                      // from about/team page
  serviceAreaCities    String[]                  // cities they serve
  serviceAreaSize      String?                   // "small" | "medium" | "large"
  enrichedAt           DateTime?                 // when enrichment last ran
  isExistingClient     Boolean   @default(false) // matches an existing SYJ User
  // ── Coordinates (from Outscraper) ──
  latitude             Float?
  longitude            Float?
  // ── Review Intelligence ──
  reviewsData          Json?                     // raw review data from Outscraper (up to 50 reviews)
  reviewsAnalyzedCount Int?                      // how many reviews we actually fetched (up to 50)
  positiveReviewCount  Int?                      // count of 4-5 star reviews in the analyzed sample
  negativeReviewCount  Int?                      // count of 1-3 star reviews in the analyzed sample
  lastReviewDate       DateTime?
  reviewVelocity90d    Int?                      // reviews in last 90 days (within analyzed sample)
  ownerResponseRate    Float?                    // 0.0-1.0 (within analyzed sample)
  lastOwnerResponseDate DateTime?
  ownerNameFromReviews String?                   // extracted from review response signatures
  reviewComplaints     String[]                  // LEGACY free-text complaints (kept for display; superseded by painTags)
  reviewPraise         String[]                  // LEGACY free-text praise (kept for display; superseded by praiseTags)
  mentionedStaffNames  String[]                  // staff names mentioned in reviews
  // ── Canonical pain/praise taxonomy (see src/lib/pain-taxonomy.ts) ──
  painTags                     String[]          // canonical pain tag IDs (e.g. ["missed_calls", "refuses_damage_claims"])
  painTagCounts                Json?             // { missed_calls: 3, slow_response: 2, ... }
  painTagCount                 Int?              // distinct pain tag count — cached for fast filtering (e.g. "2+ pains")
  praiseTags                   String[]          // canonical praise tag IDs
  praiseTagCounts              Json?
  negativeReviewPercent        Float?            // negativeReviewCount / reviewsAnalyzedCount
  mostRecentNegativeReviewDate DateTime?         // newest 1-3★ review date
  // ── GBP Profile Completeness (Outscraper Google Maps Data endpoint) ──
  businessDescription          String?   @db.Text      // GBP short/long description
  hasBusinessDescription       Boolean   @default(false)
  hasBusinessHours             Boolean   @default(false)
  isOpen24_7                   Boolean   @default(false)
  photoCount                   Int?                     // total photos on GBP profile
  hasQandAActivity             Boolean   @default(false)// has at least one Q&A
  gbpPostsLast90d              Int?                     // count of GBP posts in last 90d
  hasRecentGbpPosts            Boolean   @default(false)// gbpPostsLast90d > 0
  profileCompletenessScore     Int?                     // 0-100, weighted sum of completeness fields
  // ── Sentiment-split response rates (derived from reviewsData) ──
  negativeResponseRate         Float?                   // % of 1-3★ reviews with ownerAnswer
  positiveResponseRate         Float?                   // % of 4-5★ reviews with ownerAnswer
  respondsToNegativeReviews    Boolean   @default(false)// negativeResponseRate >= 0.5
  respondsToPositiveReviews    Boolean   @default(false)// positiveResponseRate >= 0.5
  // ── Marketing Signals ──
  hasGoogleAds         Boolean   @default(false)
  hasFacebookPixel     Boolean   @default(false)
  hasCallTracking      Boolean   @default(false)
  callTrackingProvider String?
  hasGTM               Boolean   @default(false)
  hasChatWidget        Boolean   @default(false)
  chatWidgetName       String?
  hasGoogleAnalytics   Boolean   @default(false)
  marketingMaturityScore Int?                    // 0-100 non-linear weighted
  // ── CMS / Tech Stack ──
  cmsDetected          String?                   // "WordPress" | "Wix" | "Squarespace" etc
  pageBuilder          String?                   // "Elementor" | "Divi" etc
  isDiyBuilder         Boolean   @default(false) // true for Wix, GoDaddy, Squarespace, Weebly, WP+Elementor/Divi
  websiteBuiltBy       String?                   // "diy" | "likely_diy" | "likely_agency" | "unknown"
  // ── Social Presence ──
  hasFacebook          Boolean   @default(false)
  facebookPageUrl      String?
  hasYouTube           Boolean   @default(false)
  youtubeChannelUrl    String?
  // ── Market Context ──
  marketCompetitorCount Int?
  marketCompetitionLevel String?                 // "low" | "medium" | "high"
  marketRankByReviews  Int?                      // rank within radius by review count
  marketRankPercentile Float?                    // 0.0-1.0
  // ── Owner Bio ──
  yearsInBusiness      Int?
  foundedYear          Int?                      // e.g., 2015 — year the business was founded
  isVeteranOwned       Boolean   @default(false)
  isFamilyBusiness     Boolean   @default(false)
  ownerBio             String?   @db.Text
  // ── Owner name source tracking (for traceability) ──
  ownerNameSource      String?                   // "website" | "reviews" | "web_search" | "facebook"
  ownerNameSourceUrl   String?                   // URL where the owner name was verified (especially for web_search)
  // ── Owner refinement (Phase 5) ──
  ownerFirstName       String?                   // derived from ownerName split
  ownerLastName        String?
  ownerLinkedInUrl     String?                   // promoted from ownerNameSourceUrl when source==web_search and host==linkedin
  isDirectContact      Boolean   @default(false) // heuristic: email local-part contains owner first name OR email domain matches website
  // ── Email verification / list cleaning ──
  emailDomain                  String?           // derived at write time from email
  emailDomainType              String?           // "personal" | "business_custom" | "unknown"
  emailDomainMatchesWebsite    Boolean   @default(false)
  emailDeliverable             Boolean?          // from verification service (Emailable / ZeroBounce / NeverBounce)
  emailRiskScore               Int?              // 0-100, higher = riskier
  emailVerifiedAt              DateTime?
  emailVerificationProvider    String?           // "emailable" | "zerobounce" | "neverbounce"
  emailVerificationState       String?           // "deliverable" | "undeliverable" | "risky" | "unknown" | "duplicate" | "invalid" | "missing"
  emailVerificationReason      String?
  emailVerificationScore       Int?              // provider quality score; for Emailable, higher is better
  emailVerificationRaw         Json?
  emailVerificationBatchId     String?
  emailVerificationRunId       String?
  emailCleanedAt               DateTime?
  // ── Email discovery (Phase 7 — scraped from website homepage + high-signal contact/about/service pages) ──
  emailsDiscovered             String[]          // all unique emails found on the business's site, sorted best-first (owner_direct > personalized > unknown > generic)
  emailDiscoveryCategory       String?           // category of the primary `email` field: "owner_direct" | "personalized" | "generic" | "unknown"
  emailCandidates              Json?             // ranked email candidates with source URL, source type, confidence, and verification metadata
  // ── Phone verification (Phase 5 — Twilio Lookup v2, at outreach time) ──
  phoneLineType                String?           // "mobile" | "landline" | "voip" | "unknown" — SEPARATE from `phoneType` (toll_free/local/none)
  phoneCarrier                 String?
  phoneDeliverable             Boolean?
  phoneVerifiedAt              DateTime?
  // ── Service Area NLP ──
  serviceAreaDescription String? @db.Text        // natural language description
  // ── Facebook Group Source ──
  facebookPostUrl      String?                   // link to original Facebook post
  facebookGroupName    String?                   // which group it came from
  facebookLastPostAt   String?                   // date text of most recent Facebook post (activity signal)
  discoveredVia        String?                   // "google_maps" | "yelp" | "facebook_group" | "manual"
  // ── Qualification ──
  websiteScore    Int          @default(0)
  leadScore       Int          @default(0)
  grade           String       @default("C")
  qualification   String       @default("NO")
  reasons         String[]
  // ── GPT-4o Analysis ──
  painPoints      String[]
  analysisSummary String?      @db.Text
  analysisScore   Int?
  // ── Outreach tracking ──
  smsOptOut       Boolean      @default(false)
  outreachStatus  String       @default("new") // new | emailed | sms_sent | replied | converted | skipped | opted_out
  emailedAt       DateTime?
  smsSentAt       DateTime?
  repliedAt       DateTime?
  convertedAt     DateTime?
  outreachNotes   String?      @db.Text
  archivedAt      DateTime?
  archiveReason   String?
  archiveSource   String?
  // ── Lead Cleaner audit/idempotency layer ──
  cleanerVerdict     String?    // "keep" | "reject"
  cleanerReason      String?    // e.g. "franchise:Junk King", "category_deny:scrap_yard", "llm_reject:unrelated_business"
  cleanerDecidedBy   String?    // "rule" | "llm"
  cleanerConfidence  Float?     // LLM confidence 0..1; null for rule decisions
  cleanerRunId       String?    // SyjAgentRun.id that judged the lead
  cleanedAt          DateTime?  // null = never judged by Lead Cleaner
  outreachLogs    OutreachLog[]
  outreachQueue   OutreachQueue[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([grade, outreachStatus])
  @@index([market])
  @@index([agentRunId])
  @@index([companyType])
  @@index([enrichedAt])
  @@index([isExistingClient])
  @@index([painTagCount])
  @@index([mostRecentNegativeReviewDate])
  @@index([profileCompletenessScore])
  @@index([rating])
  @@index([primaryBottleneck])
  @@index([daysSinceLastReview])
  @@index([state])
  @@index([emailDiscoveryCategory])
  @@index([emailDeliverable])
  @@index([emailVerificationState])
  @@index([archivedAt])
  @@index([cleanedAt])
  @@index([enrichedAt, archivedAt, isExistingClient, cleanedAt])
  groupMemberships LeadGroupMember[]
}

// ── Lead Groups & Templates (admin outreach campaigns) ──────────────────────
model LeadGroup {
