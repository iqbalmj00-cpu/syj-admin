  campaignVersion   ColdEmailCampaignVersion @relation(fields: [campaignVersionId], references: [id], onDelete: Restrict)
  attributionTokenId String?
  attributionToken  ColdEmailAttributionToken? @relation(fields: [attributionTokenId], references: [id], onDelete: SetNull)
  companyId         String?
  company           ColdEmailCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId         String?
  contact           ColdEmailContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunityId     String?
  opportunity       ColdEmailOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  customerLinkId    String?
  customerLink      ColdEmailCustomerLink? @relation(fields: [customerLinkId], references: [id], onDelete: SetNull)
  touchType         String
  matchMethod       String
  confidence        Float?
  evidence          Json?
  isFirstTouch      Boolean  @default(false)
  isLastTouch       Boolean  @default(false)
  isPrimary         Boolean  @default(false)
  occurredAt        DateTime
  createdAt         DateTime @default(now())

  @@index([campaignVersionId, occurredAt])
  @@index([opportunityId, occurredAt])
  @@index([customerLinkId, occurredAt])
  @@index([isPrimary, occurredAt])
}

model ColdEmailCustomerLink {
  id                    String   @id @default(cuid())
  companyId             String
  company               ColdEmailCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contactId             String?
  contact               ColdEmailContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunityId         String?
  opportunity           ColdEmailOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  scaleYourJunkUserId   String?  @unique
  scaleYourJunkUser     User? @relation(fields: [scaleYourJunkUserId], references: [id], onDelete: SetNull)
  status                String   @default("prospect") // prospect | trial_activated | product_activated | paying | comped | churned
  matchMethod           String
  matchConfidence       Float?
  activatedAt           DateTime?
  payingAt              DateTime?
  churnedAt             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  attributionTouches ColdEmailAttributionTouch[]
  paymentProjections ColdEmailPaymentProjection[]
  manualPaymentEvidence ColdEmailManualPaymentEvidence[]

  @@index([companyId, status])
  @@index([opportunityId])
  @@index([status, updatedAt])
}

model ColdEmailPaymentProjection {
  id                   String   @id @default(cuid())
  customerLinkId       String
  customerLink         ColdEmailCustomerLink @relation(fields: [customerLinkId], references: [id], onDelete: Cascade)
  opportunityId        String?
  opportunity          ColdEmailOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  stripeEventId        String?  @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripeInvoiceId      String?
  stripePaymentIntentId String?
  eventType            String
  status               String
  amountCents          Int?
