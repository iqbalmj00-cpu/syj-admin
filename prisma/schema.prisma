generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                   String                @id @default(cuid())
  name                 String?
  email                String?               @unique
  emailVerified        DateTime?
  password             String?
  company              String?
  image                String?
  gaPropertyId         String?
  gaAccessToken        String?               @db.Text
  gaRefreshToken       String?               @db.Text
  role                 String                @default("owner") // owner | admin | dispatcher | finance | csr | viewer
  orgId                String? // links team members to org owner's User.id
  inviteToken          String?               @unique
  inviteExpiresAt      DateTime?
  siteToken            String?               @unique @default(cuid())
  accounts             Account[]
  sessions             Session[]
  onboarding           OnboardingSubmission?
  leads                Lead[]
  goals                UserGoal[]
  websiteEvents        WebsiteEvent[]
  phoneCalls           PhoneCall[]
  quoteSessions        QuoteSession[]
  customers            Customer[]
  trucks               Truck[]
  jobs                 Job[]
  invoices             Invoice[]
  // ── Master Plan relations ──
  staff                Staff[]
  notifications        Notification[]
  reviews              Review[]
  reviewTemplates      ReviewTemplate[]
  campaigns            Campaign[]
  priceBooks           PriceBook[]
  locations            Location[]
  crewAssignments      CrewAssignment[]
  shiftSegments        ShiftSegment[]
  dumpTickets          DumpTicket[]
  websiteContent       WebsiteContent[]
  widgetConfig         WidgetConfig?
  automationConfig     AutomationConfig?
  integrations         Integration[]
  webhookSubscriptions WebhookSubscription[]
  portalTokens         PortalToken[]         @relation("PortalTokens")
  expenses             Expense[]
  incidents            Incident[]
  estimates            Estimate[]
  teamInvites          TeamInvite[]
  scheduleConfig       ScheduleConfig?
  auditLogs            AuditLog[]
  // ── Phase 1 new relations ──
  recurringJobSeries   RecurringJobSeries[]
  jobTags              JobTag[]
  companyProfile       CompanyProfile?
  dispatchMessages     DispatchMessage[]
  referrals            Referral[]
  promoCodes           PromoCode[]
  platformPromoRedemptions PlatformPromoRedemption[]
  reviewGates          ReviewGate[]
  customFields         CustomField[]
  messageTemplates     MessageTemplate[]
  communications       Communication[]
  followUpTasks        FollowUpTask[]
  coldEmailCustomerLink ColdEmailCustomerLink?
  // ── Onboarding Wizard relations ──
  websiteConfig        WebsiteConfig?
  stripeConnectAccount StripeConnectAccount?
  phoneConfig          PhoneConfig?
  // ── 19-Feature Plan relations ──
  staffSchedules       StaffSchedule[]
  staffTimeOffs        StaffTimeOff[]
  maintenanceRecords   MaintenanceRecord[]
  cancellationRecords  CancellationRecord[]
  dumpFacilities       DumpFacility[]
  durationConfig       DurationConfig?
  // ── Notification prefs ──
  onboardingComplete   Boolean               @default(false)
  notifyNewLead        Boolean               @default(true)
  notifyBooking        Boolean               @default(true)
  notifyWeeklyReport   Boolean               @default(true)
  notificationPreferences Json? // { event_key: { email: bool, sms: bool, push: bool } }
  dailyDigest          Boolean               @default(false)
  reportRecipients     String? // comma-separated email addresses
  reportFrequency      String                @default("weekly") // "daily" | "weekly"
  onboardingProgress   Json? // tracks onboarding checklist completion
  // ── SaaS Billing (Stripe) ──
  saasStripeCustomerId String? // Stripe Customer for SaaS billing (NOT client invoicing)
  stripeSubscriptionId String?
  stripePriceId        String?
  planTier             String                @default("starter") // starter | growth | enterprise
  planStatus           String                @default("trialing") // trialing | active | past_due | canceled
  platformBillingSource String               @default("stripe") // stripe | promo_lifetime
  billingCancelledAt   DateTime?
  cancelReason         String? // too_expensive | missing_features | switching | other
  cancelFeedback       String?               @db.Text
  retentionOfferShown  Boolean               @default(false)
  dataDeletedAt        DateTime? // set by data-cleanup cron after 30-day purge
  lastLoginAt          DateTime? // last time owner viewed Command Center (for "new since" alerts)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  agentConfig          AgentConfig?
  taxRates             TaxRate[]
  // ── Dumpster Rental relations ──
  containers           Container[]
  rentals              Rental[]
  dumpsterPriceTiers   DumpsterPriceTier[]
  dumpsterSurcharges   DumpsterSurcharge[]
  // ── Document Storage & Broker relations ──
  documents            Document[]
  jobTemplates         CustomerJobTemplate[]
  brokers              Broker[]
  dispatchZones        DispatchZone[]
  // ── Admin Dashboard expansion relations ──
  agentErrorLogs       AgentErrorLog[]
  websiteHealthChecks  WebsiteHealthCheck[]
  // ── Support Ticket relations ──
  isDemoAccount        Boolean               @default(false)
  supportTickets       SupportTicket[]
  // ── A2P / Sub-Account relation ──
  twilioSubAccount     TwilioSubAccount?
}

model OnboardingSubmission {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName  String
  location      String
  fleetSize     String
  serviceRadius Int?
  baseRate      Float?
  perCubicYard  Float?
  minLoadFee    Float?
  currentCRM    String?
  websiteURL    String?
  websiteMode   String   @default("syj_hosted") // "syj_hosted" | "widget_embed"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Lead {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  email             String?
  phone             String?
  address           String?
  accessNotes       String?        @db.Text
  source            String // phone_ai | photo_quote | website_form | manual
  images            String[] // uploaded photo URLs from website form
  description       String?        @db.Text // customer's "Items to remove" free text
  requestedDate     DateTime? // preferred pickup date from form
  metadata          Json? // calculator values (estimatedVolume, estimatedPrice, etc.)
  status            String         @default("new") // new | contacted | quoted | booked | completed | lost
  value             Float?
  notes             String?        @db.Text
  // ── Master Plan additions ──
  aiManaged         Boolean        @default(false) // AI pipeline managing this lead
  interestScore     Float? // 0–1 engagement score
  lastAiMessage     String?        @db.Text // last AI-generated message
  customerId        String?
  customer          Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  jobs              Job[]
  chatMessages      ChatMessage[]
  followUpTasks     FollowUpTask[]
  recoverySmsSentAt DateTime? // recovery SMS sent timestamp (max 1 per lead)
  newLeadSmsSentAt  DateTime? // 10-min follow-up SMS timestamp (new + quoted leads)
  quotedAt          DateTime? // when lead was moved to "quoted" status
  // ── Phase 1 additions ──
  lostReason        String? // why lead was lost (e.g. price | timing | no_response)
  lostReasonNotes   String?        @db.Text // free-text detail for lost reason
  estimatedVolume   String? // display label like "~half truck"
  // ── Dumpster Rental additions ──
  serviceType       String         @default("junk_removal") // junk_removal | dumpster_rental
  // ── Broker relation ──
  brokerId          String?
  broker            Broker?        @relation(fields: [brokerId], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model UserGoal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  target    Float
  current   Float    @default(0)
  unit      String   @default("count")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

model DemoRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  fleetSize String?
  message   String?  @db.Text
  createdAt DateTime @default(now())
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model WebsiteEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     String // page_view | book_now_click | quote_upload | booking_finalized
  page      String? // e.g. "/", "/pricing", "/solutions/ai-phone"
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, event])
  @@index([userId, createdAt])
}

model PhoneCall {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  twilioCallSid   String?   @unique
  fromNumber      String?
  toNumber        String?
  callerName      String?
  duration        Int // seconds
  outcome         String // booked | voicemail | missed | info_only | callback_requested
  appointmentDate DateTime?
  summary         String?   @db.Text // AI-generated call summary
  recordingUrl    String?
  createdAt       DateTime  @default(now())

  @@index([userId, createdAt])
}

model QuoteSession {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName     String?
  customerEmail    String?
  customerPhone    String?
  junkSummary      String    @db.Text // AI description of items detected
  volumeCubicYards Float // calculated volume
  priceQuoted      Float // dollar amount (low end of range)
  priceMax         Float? // dollar amount (high end of range, optional)
  status           String    @default("quoted") // quoted | accepted | declined | expired
  createdAt        DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([customerId])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

// ─── Existing Business Models (Modified) ─────────────────────────────────────

model Customer {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  email            String?
  phone            String?
  address          String?
  type             String          @default("residential") // residential | commercial | realtor
  isVip            Boolean         @default(false)
  notes            String?         @db.Text
  // ── Master Plan additions ──
  tags             String[] // VIP, LATE_PAYER, COMMERCIAL etc.
  stripeCustomerId String? // Stripe customer ID for invoicing
  // ── 19-Feature: Card-on-file metadata ──
  hasCardOnFile    Boolean         @default(false)
  cardLast4        String?
  cardBrand        String?
  cardExpiry       String?  // "MM/YY" display format
  // ── Phase 7: Payment policy ──
  creditApproved   Boolean         @default(false) // credit-approved for NET_TERMS
  creditLimit      Float? // max outstanding AR
  // ── Phase 9: QuickBooks sync ──
  qbCustomerId     String? // QuickBooks Customer ID
  // ── Phase 1 additions ──
  source           String? // acquisition origin: referral | google | yelp | repeat | other
  referredBy       String? // who referred this customer
  riskScore        String          @default("low") // low | medium | high
  doNotService     Boolean         @default(false) // flagged customers
  companyName      String? // commercial company name
  billingContact   String? // commercial billing contact
  poNumber         String? // purchase order number
  netTerms         Int? // 15 | 30 | 60 days
  lastContactAt    DateTime? // last interaction timestamp
  leads            Lead[]
  jobs             Job[]
  invoices         Invoice[]
  locations        Location[]
  portalTokens     PortalToken[]
  estimates        Estimate[]
  customerNotes    CustomerNote[]
  parentId         String?
  parent           Customer?       @relation("CustomerParent", fields: [parentId], references: [id], onDelete: SetNull)
  children         Customer[]      @relation("CustomerParent")
  archivedAt       DateTime?
  reviews          Review[]
  quoteSessions    QuoteSession[]
  communications      Communication[]
  followUpTasks       FollowUpTask[]
  recurringJobSeries  RecurringJobSeries[]
  // ── Dumpster Rental relation ──
  rentals             Rental[]
  // ── Job Templates relation (commercial) ──
  jobTemplates        CustomerJobTemplate[]
  // ── Document Storage relation ──
  documents           Document[]
  // ── Portal notification preferences ──
  notifyJobScheduled    Boolean         @default(true)
  notifyDriverEnRoute   Boolean         @default(true)
  notifyJobCompleted    Boolean         @default(true)
  notifyInvoiceReady    Boolean         @default(true)
  notifyChannel         String          @default("email") // email | sms | both
  reviewGates         ReviewGate[]
  createdAt           DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId, name])
  @@index([userId, phone])
}

model Truck {
  id                  String              @id @default(cuid())
  userId              String
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String // "Truck 01"
  capacityCuYd        Float               @default(12) // cubic yards (legacy — not used for dispatch logic)
  crewMembers         String? // comma-separated crew names (legacy)
  status              String              @default("available") // available | en_route | working | dumping | maintenance
  lastDumpStart       DateTime? // for dump wait-time analytics
  currentLoadStatus   String              @default("EMPTY") // EMPTY | QUARTER | HALF | THREE_QUARTERS | FULL
  lastLoadReportAt    DateTime?
  // ── Master Plan additions ──
  type                String              @default("dump") // dump | box | trailer | pickup
  bodyType            String? // 16yd | 20yd | open-top
  homeBaseZip         String? // for Haversine origin
  noHeavy             Boolean             @default(false) // can't handle heavy items
  lowClearance        Boolean             @default(false) // height restricted
  nextServiceDate     DateTime? // maintenance scheduling
  notes               String?             @db.Text
  currentLat          Float? // real-time GPS lat (updated by position API)
  currentLng          Float? // real-time GPS lng (updated by position API)
  yardLat             Float? // home yard/depot latitude for dispatch clustering
  yardLng             Float? // home yard/depot longitude for dispatch clustering
  // ── Phase 1 additions ──
  licensePlate        String? // vehicle plate number
  mileage             Int? // current odometer reading
  fuelTankCost        Float    @default(100) // cost to fill tank in $ (legacy)
  milesPerTank        Float    @default(500) // miles per full tank (legacy)
  mpg                 Float?  // miles per gallon
  fuelPricePerGallon  Float?  // per-truck fuel price
  lastMaintenanceDate DateTime? // last service date
  nextMaintenanceDate DateTime? // next scheduled service date
  // ── Dumpster Rental additions ──
  truckType           String              @default("junk_removal") // junk_removal | roll_off
  maxContainerSizeCuYd Int? // max dumpster size this truck can haul (roll-off only)
  currentContainerId  String? // container currently on the truck
  // ── Fleet Telematics additions ──
  telematicsVehicleId  String?
  telematicsProvider   String?
  jobs                Job[]
  crewAssignments     CrewAssignment[]
  shiftSegments       ShiftSegment[]
  positions           TruckPosition[]
  dumpTickets         DumpTicket[]
  expenses            Expense[]
  incidents           Incident[]
  preTripInspections  PreTripInspection[]
  defaultCrew         Staff[]             @relation("DefaultCrew")
  maintenanceRecords  MaintenanceRecord[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([userId, status])
}

model Job {
  id                   String              @id @default(cuid())
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId           String?
  customer             Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  leadId               String?
  lead                 Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  truckId              String?
  truck                Truck?              @relation(fields: [truckId], references: [id], onDelete: SetNull)
  locationId           String?
  location             Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  title                String // "Garage Cleanout"
  address              String? // freeform address (coexists with locationId)
  accessNotes          String?             @db.Text // gate codes, dog warnings
  scheduledStart       DateTime?
  scheduledEnd         DateTime?
  // ── Phase 7A: Schedule normalization ──
  scheduledDate        DateTime? // date-only for planning
  windowStart          DateTime? // arrival window start (from external CRM)
  windowEnd            DateTime? // arrival window end (from external CRM)
  slot                 String? // MORNING | MIDDAY | EVENING | UNPLANNED (derived)
  planStatus           String              @default("tentative") // tentative | planned | locked
  volumeCuYd           Float? // estimated cubic yards
  actualVolumeTier     String? // QUARTER | HALF | THREE_QUARTER | FULL | OVERSIZE (driver-reported)
  status               String              @default("scheduled") // scheduled | en_route | working | completed | paid
  type                 String              @default("pickup") // pickup | onsite_estimate
  jobCategory          String              @default("residential") // residential | commercial
  amountQuoted         Float?
  amountQuotedMax      Float?
  amountPaid           Float               @default(0)
  // ── Master Plan additions ──
  disposalCost         Float? // actual dump fee
  laborCost            Float? // actual labor cost
  fuelCost             Float? // actual fuel cost
  distanceMiles        Float?
  hasHeavyItems        Boolean             @default(false)
  hasPhotos            Boolean             @default(false)
  invoicedAt           DateTime? // when batch-invoiced
  // ── Dispatch solver additions ──
  predictedDuration    Int?     @default(30) // solver-estimated minutes
  plannedDuration      Int?
  actualDuration       Int?
  accessComplexity     String   @default("standard")
  floorLevel           Int      @default(1)
  requiresDisassembly  Boolean  @default(false)
  distanceFromTruck    String   @default("standard")
  revenue              Float?
  volumeConfidence     String   @default("estimated")
  // ── Phase 9 additions ──
  signatureUrl         String? // signed damage waiver image URL
  signedAt             DateTime? // when waiver was signed
  damageWaiverAccepted Boolean             @default(false)
  routeOrder           Int                 @default(0) // position in optimized route sequence
  // ── Phase 1 additions ──
  cancelledAt          DateTime? // when job was cancelled
  cancelReason         String? // reason for cancellation
  recurringSeriesId    String? // FK to RecurringJobSeries
  recurringJobSeries   RecurringJobSeries? @relation(fields: [recurringSeriesId], references: [id], onDelete: SetNull)
  tags                 String[] // job type tags (garage_cleanout, estate, etc.)
  poNumber             String?
  // ── Dumpster Rental additions ──
  rentalId             String? // FK to Rental (for rental-linked jobs)
  rental               Rental?             @relation("RentalJobs", fields: [rentalId], references: [id])
  liveLoadStartedAt    DateTime?
  liveLoadEndedAt      DateTime?
  items                JobItem[]
  invoices             Invoice[]
  evidence             JobEvidence[]
  activities           JobActivity[]
  dumpTickets          DumpTicket[]
  incidents            Incident[]
  followUpTasks        FollowUpTask[]
  jobCrewAssignments   JobCrewAssignment[]
  taxRates             TaxRate[]
  estimate             Estimate?
  checklistItems       ChecklistItem[]
  timerStartedAt       DateTime? // crew mode work timer
  completedAt          DateTime?
  enRouteAt            DateTime?
  arrivedAt            DateTime?
  startRouteLat        Float?
  startRouteLng        Float?
  arrivedLat           Float?
  arrivedLng           Float?
  paymentStatus        String              @default("unpaid")
  reviewRequestedAt    DateTime?
  calendarEventId      String?
  timeSlot             String?
  // ── Broker & Document relations ──
  brokerId             String?
  broker               Broker?             @relation(fields: [brokerId], references: [id])
  promoCodeId          String?
  promoCode            PromoCode?          @relation(fields: [promoCodeId], references: [id])
  documents            Document[]
  reviewGates          ReviewGate[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([userId, scheduledStart])
  @@index([userId, status])
  @@index([truckId, scheduledStart])
}

model JobItem {
  id          String  @id @default(cuid())
  jobId       String
  job         Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  description String
  category    String? // appliance | recyclable | wood | furniture | mattress | general
  quantity    Int     @default(1)
  notes       String?
  photoUrl    String?
}

model Invoice {
  id                    String            @id @default(cuid())
  userId                String
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId            String?
  customer              Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  jobId                 String?
  job                   Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  invoiceNumber         Int
  status                String            @default("draft") // draft | sent | viewed | paid | overdue | refunded
  subtotal              Float             @default(0)
  taxRate               Float             @default(8.25)
  taxAmount             Float             @default(0)
  total                 Float             @default(0)
  attachPhotos          Boolean           @default(false)
  stripePaymentLink     String?
  notes                 String?           @db.Text
  // ── Master Plan additions ──
  isBatch               Boolean           @default(false) // batch billing invoice
  issuedAt              DateTime          @default(now())
  dueAt                 DateTime?
  paidAt                DateTime?
  // ── Phase 9: Stripe payments ──
  stripePaymentIntentId String? // Stripe PaymentIntent ID
  stripeReceiptUrl      String? // Stripe receipt URL
  refundedAt            DateTime?
  refundAmount          Float?
  // ── Phase 9: QuickBooks sync ──
  qbInvoiceId           String? // QuickBooks Invoice ID
  qbSyncStatus          String? // synced | failed | pending
  qbSyncError           String? // error message if failed
  qbSyncedAt            DateTime?
  // ── Phase 1 additions ──
  lastReminderSentAt    DateTime? // prevents duplicate cron reminders
  // ── Phase 4 additions ──
  depositAmount         Float             @default(0) // upfront deposit collected
  tipAmount             Float             @default(0) // tip added by customer
  amountPaid            Float             @default(0) // total actually paid (for partial payments)
  paymentMethod         String? // card_on_file | payment_link | cash | check
  pdfUrl                String? // generated invoice PDF URL
  // ── Dumpster Rental addition ──
  rentalId              String? // FK to Rental (for rental invoices)
  rental                Rental?           @relation("RentalInvoices", fields: [rentalId], references: [id])
  lineItems             InvoiceLineItem[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([userId, status])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  notes       String?
  quantity    Int     @default(1)
  unitPrice   Float
  amount      Float
}

// ─── Master Plan New Models ──────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // job_alert | invoice_overdue | lead_new | capacity_warning | dispatch_change | price_overcharge | idle_truck | job_assigned
  title     String
  body      String   @db.Text
  link      String? // deep link into dashboard (e.g. "/dashboard/jobs/abc123")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model Staff {
  id                   String              @id @default(cuid())
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedUserId         String?             @unique // links to User.id for driver login
  name                 String
  phone                String?
  email                String?
  role                 String              @default("laborer") // laborer | driver | dispatcher | finance | customer_service | admin
  status               String              @default("active") // active | inactive
  payType              String              @default("hourly") // "hourly" | "salary"
  hourlyRate           Float? // PRIVATE — admin-only, used for profit calc (hourly employees)
  annualSalary         Float? // PRIVATE — yearly salary (salaried employees)
  certifications       String[] // CDL, hazmat, etc.
  pin                  String?             // 4-6 digit PIN for driver page auth (unique per company)
  pinDeviceId          String? // optional device trust binding
  notes                String?             @db.Text
  // ── Phase 1 additions ──
  hireDate             DateTime?
  driversLicenseExpiry DateTime?
  insuranceExpiry      DateTime?
  isOnBreak            Boolean             @default(false) // break toggle for dispatch visibility
