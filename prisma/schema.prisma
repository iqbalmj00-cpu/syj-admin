model WebsiteContent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  section   String // hero | services | announcement | pricing | about
  content   Json // section-specific structured content
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, section])
}

model WidgetConfig {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode           String   @default("overlay") // overlay | embed | hosted
  brandColor     String   @default("#FF6B00")
  serviceZips    String[] // allowed ZIP codes
  enablePhotos   Boolean  @default(true)
  enableCalendar Boolean  @default(true)
  customCss      String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AutomationConfig {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  autoAssignTruck      Boolean  @default(false) // auto-fill closest available truck
  autoFollowUp         Boolean  @default(false) // send follow-up after quote
  followUpDelayHours   Int      @default(24)
  autoReviewRequest    Boolean  @default(false) // send review request after job
  reviewRequestDelay   Int      @default(48) // hours after completion
  aiPipelineEnabled    Boolean  @default(false) // AI lead engagement
  paymentMode          String   @default("card") // card | flexible (enables offline-collected + net-terms)
  googleReviewUrl      String? // Google Business review URL
  yelpReviewUrl        String? // Yelp review URL
  // ── Phase 1 additions ──
  autoPaymentReminders Boolean  @default(false) // enable payment reminder cron
  paymentReminderDays  Int[]    @default([3, 7, 14, 30]) // days after due to remind
  autoReEngagement     Boolean  @default(false) // enable re-engagement cron
  reEngagementMonths   Int      @default(3) // months of inactivity before re-engage
  businessHours            Json? // {mon:{open,close,closed},...sun:{...}}
  // ── 19-Feature: Status notification toggles ──
  notifyBookingConfirm     Boolean  @default(true)  // SMS on booking
  notifyDayBefore          Boolean  @default(true)  // SMS day before scheduled date
  notifyEnRoute            Boolean  @default(true)  // SMS on en_route (guards existing behavior)
  notifyJobComplete        Boolean  @default(true)  // SMS receipt on completion
  // ── 19-Feature: Recovery discount config ──
  recoveryDiscountPercent  Int? // null = no discount, 10 = 10% off
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model AgentConfig {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentName     String   @default("Sarah")     // voice agent's name
  voiceId       String?                        // Cartesia voice ID
  timezone      String   @default("America/Chicago")
  businessStart Int      @default(7)           // 24h hour, e.g. 7 = 7am
  businessEnd   Int      @default(19)          // 24h hour, e.g. 19 = 7pm
  businessDays  Int[]    @default([0,1,2,3,4,5]) // 0=Sun … 6=Sat
  smsEnabled    Boolean  @default(true)        // send post-booking SMS
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Integration {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String // stripe | quickbooks | google_maps | google_business | twilio | ga4 | resend
  status       String    @default("disconnected") // connected | disconnected | error
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  expiresAt    DateTime?
  config       Json? // provider-specific settings
  connectedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, provider])
}

model TruckPosition {
  id        String   @id @default(cuid())
  truckId   String
  truck     Truck    @relation(fields: [truckId], references: [id], onDelete: Cascade)
