// ── Phase 5A: Expenses ──
model Expense {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffId    String?
  staff      Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  truckId    String?
  truck      Truck?   @relation(fields: [truckId], references: [id], onDelete: SetNull)
  category   String // fuel | tolls | supplies | other
  amount     Float
  receiptUrl String? // optional receipt photo (via Cloudinary)
  notes      String?
  status     String   @default("pending") // pending | approved | rejected
  approvedBy String?
  date       DateTime @db.Date
  mileage    Float? // IRS mileage tracking
  createdAt  DateTime @default(now())

  @@index([userId, status])
  @@index([staffId])
}

// ── Phase 6A: Incidents ──
model Incident {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffId               String
  staff                 Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  truckId               String?
  truck                 Truck?    @relation(fields: [truckId], references: [id], onDelete: SetNull)
  jobId                 String?
  job                   Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  type                  String // vehicle_accident | property_damage | injury | near_miss
  description           String    @db.Text
  photos                String[] // array of Cloudinary URLs (min 3)
  gpsLat                Float?
  gpsLng                Float?
  severity              String    @default("low") // low | medium | high | critical
  resolved              Boolean   @default(false)
  resolvedAt            DateTime?
  resolvedBy            String?
  // ── Phase 1 additions: insurance tracking ──
  resolutionNotes       String?   @db.Text
  insuranceClaimNumber  String?
  insuranceAdjuster     String?
  insuranceClaimStatus  String? // filed | review | approved | denied | paid
  insurancePayoutAmount Float?
  createdAt             DateTime  @default(now())

  @@index([userId, createdAt])
}

// ── Phase 6B: Estimates ──
model Estimate {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId       String?
  customer         Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  staffId          String
  staff            Staff          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  jobId            String?        @unique
  job              Job?           @relation(fields: [jobId], references: [id], onDelete: SetNull)
  status           String         @default("draft") // draft | sent | accepted | expired
  subtotal         Float          @default(0)
  taxRate          Float          @default(8.25)
  taxAmount        Float          @default(0)
  total            Float          @default(0)
  signatureUrl     String?
  pdfUrl           String?
  validUntil       DateTime?
  convertedJobId   String?
  notes            String?        @db.Text
  // ── Phase 1 additions ──
  version          Int            @default(1) // estimate version number
  parentEstimateId String? // FK for version chain (v1 → v2 → v3)
  parentEstimate   Estimate?      @relation("EstimateVersions", fields: [parentEstimateId], references: [id])
  childEstimates   Estimate[]     @relation("EstimateVersions")
  photos           String[] // on-site photo URLs
  rooms            EstimateRoom[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId, status])
}

model EstimateRoom {
  id         String         @id @default(cuid())
  estimateId String
  estimate   Estimate       @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  name       String
  items      EstimateItem[]
}

model EstimateItem {
  id          String       @id @default(cuid())
  roomId      String
  room        EstimateRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  description String
  quantity    Int          @default(1)
  unitPrice   Float
  amount      Float
  isCustom    Boolean      @default(false)
}

// ── Phase 7: Schedule Config ─────────────────────────────────────────────────

model ScheduleConfig {
  id           String   @id @default(cuid())
  userId       String   @unique
