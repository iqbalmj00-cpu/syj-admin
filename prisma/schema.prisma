  demoUserId      String?
}

// ── Twilio A2P Sub-Account (read-only from admin dash) ──────────────────────
model TwilioSubAccount {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Sub-Account ──
  subAccountSid          String    @unique
  subAccountAuthToken    String

  // ── Trust Hub ──
  customerProfileSid     String?
  customerProfileStatus  String    @default("pending") // pending | in_review | approved | rejected
  trustProductSid        String?
  trustProductStatus     String    @default("pending") // pending | in_review | approved | rejected

  // ── Brand ──
  brandSid               String?
  brandStatus            String    @default("pending") // pending | approved | failed
  brandType              String    @default("SOLE_PROPRIETOR")
  otpVerified            Boolean   @default(false)

  // ── Campaign ──
  campaignSid            String?
  campaignStatus         String    @default("pending") // pending | verified | failed

  // ── Messaging Service ──
  messagingServiceSid    String?
  messagingServiceStatus String    @default("pending")

  // ── Operational Status ──
  voiceEnabled           Boolean   @default(true)
  smsEnabled             Boolean   @default(false)
  registrationType       String    @default("sole_proprietor")
  a2pStarted             Boolean   @default(false)

  // ── Error Tracking ──
  lastError              String?   @db.Text
  lastSyncAt             DateTime?

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([smsEnabled])
  @@index([a2pStarted])
}

model ContentAsset {
  id               String   @id @default(cuid())
  type             String   @default("screenshot")  // "screenshot" | "before_image"
  surface          String?                          // "admin_dashboard" | "driver_app" | "customer_portal" | "customer_website"
  feature          String?                          // free text — e.g. "dispatch", "revenue", "booking"
  state            String?  @db.Text                // human description of what's shown
  storyTags        String[]                         // e.g. ["automation", "time_saved", "night_bookings"]
  orientation      String                           // "desktop" | "desktop-lifestyle" | "mobile-portrait" | "tablet-landscape"
  blobUrl          String                           // public Vercel Blob URL of the screenshot
  annotationZones  Json?                            // optional {top-left: {x,y}, top-right: {x,y}, ...} for Feature Callout template
  active           Boolean  @default(true)          // admin can toggle off without deleting
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([type])
  @@index([orientation])
  @@index([active])
}

model ResearchReport {
  id                String       @id @default(cuid())
  agentRunId        String?
  agentRun          SyjAgentRun? @relation(fields: [agentRunId], references: [id])

  // Report identity
  slug              String       @unique
  title             String
  subtitle          String       @db.Text
  category          String
  categoryIcon      String
  author            String       @default("Jamal Iqbal")

  // Content
  topic             String       @db.Text        // the research topic the user entered
  reportType        String       @default("custom")  // market_analysis | competitor_study | trend_report | operational_benchmark | custom
  excerpt           String       @db.Text        // 1-2 sentence card preview
  execSummary       String       @db.Text        // 3-5 sentence paragraph for detail page
  keyFindings       String[]                     // 4-6 bullets
  fullReportContent Json                         // { sections: [{heading, paragraphs, bullets}], conclusion }

  // About this report
  sourceCount       Int          @default(0)
  dataRange         String                       // e.g. "2024-2026"
  methodology       String       @db.Text        // 1 paragraph
  sources           Json                         // [{title, url, snippet}]

  // SEO
  keywords          String[]
  metaDescription   String       @db.Text        // ≤160 chars

  // PDF
  pageCount         Int          @default(0)
  pdfSizeMb         Float        @default(0)
  draftPdfUrl       String?                      // URL of the PDF on Vercel Blob
  publishedPdfUrl   String?                      // same URL once published (kept separate for audit)

  // Workflow
  status            String       @default("draft") // draft | approved | published | archived | rejected
  warnings          Json?                        // validation warnings from generator
  publishedAt       DateTime?
  archivedAt        DateTime?
  githubSha         String?                      // SHA of GitHub commit when published
  rejectedReason    String?                      // optional note when user rejects a draft

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status])
  @@index([category])
  @@index([agentRunId])
}

// ── Demo Scheduler — Google Calendar OAuth ──────────────────────────────────
// Stores the admin's Google OAuth tokens for the demo booking flow.
// Singleton — only one row ever exists (provider is unique).
// Mirrored from the SYJ website schema. Shared DB (already db-pushed by SYJ dev).

model AdminIntegration {
  id           String    @id @default(cuid())
  provider     String    @unique // "google_calendar" for the demo scheduler
  status       String    @default("disconnected") // connected | disconnected | error
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  expiresAt    DateTime?
  email        String?   // Google account used (e.g., jamal@scaleyourjunk.com)
  config       Json?     // provider-specific extras
  connectedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ── Demo Scheduler Config (singleton) ────────────────────────────────────────
// Drives the /book-a-demo visitor calendar: which calendar to write to,
// business hours, duration, buffer, and booking window.
// Only one row ever exists. Edit via admin dashboard.
model DemoSchedulerConfig {
  id              String   @id @default(cuid())
  calendarId      String   @default("primary")
  timezone        String   @default("America/Chicago")
  demoDurationMin Int      @default(30)
  bufferMin       Int      @default(15)
  minNoticeHours  Int      @default(12)
  maxDaysAhead    Int      @default(30)
  businessHours   Json // { mon: {start:"09:00",end:"17:00"}, ..., sun: null }
  lunchBreak      Json? // { start:"12:00", end:"13:00" } or null
  enabled         Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

// ── Demo Bookings ────────────────────────────────────────────────────────────
// Each visitor-booked demo call. Created by /api/book-demo/create (on SYJ website)
// after the Meet space + Calendar event are successfully provisioned.
// Admin dashboard reads these for the Demo Scheduler UI.
model DemoBooking {
  id              String   @id @default(cuid())
  name            String
  email           String
  phone           String?
  company         String?
  fleetSize       String?
  message         String?  @db.Text
  startsAt        DateTime
  endsAt          DateTime
  visitorTimezone String
  meetUrl         String
  meetSpaceId     String? // Google Meet REST API space name (spaces/xxx)
  calendarEventId String // Google Calendar event id
  status          String   @default("scheduled") // scheduled | cancel_pending | reschedule_pending | cancelled | completed | no_show
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  coldEmailMeeting ColdEmailMeeting?

  @@index([startsAt])
  @@index([email])
  @@index([status])
}
