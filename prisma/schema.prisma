  campaign    ColdEmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  metricDate  DateTime
  scopeKey    String
  dimensions  Json?
  metrics     Json
  dataState   String   @default("complete") // complete | partial | stale | unavailable
