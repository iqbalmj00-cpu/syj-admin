  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformPromoCodeId   String
  platformPromoCode     PlatformPromoCode @relation(fields: [platformPromoCodeId], references: [id], onDelete: Cascade)
  code                  String
  planTier              String
  discountType          String
  discountValue         Float
  discountDuration      String
  noCardRequired        Boolean
  lifetimeAccess        Boolean           @default(false)
  platformBillingSource String
  stripeSubscriptionId  String?
  stripeCouponId        String?
  redeemedAt            DateTime          @default(now())

  @@unique([userId, platformPromoCodeId])
  @@index([userId])
  @@index([platformPromoCodeId])
}

