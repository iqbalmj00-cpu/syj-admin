  updatedAt       DateTime          @updatedAt
  members         LeadGroupMember[]
  campaignLaunches CampaignLaunch[]
  coldEmailAudienceSnapshots ColdEmailAudienceSnapshot[]
}

model LeadGroupMember {
  id      String      @id @default(cuid())
