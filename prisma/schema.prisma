  @@index([userId, active])
}

model PriceTier {
  id          String    @id @default(cuid())
  priceBookId String
  priceBook   PriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  label       String // "1/8 Load", "1/4 Load", etc.
  minCuYd     Float
  maxCuYd     Float
  price       Float
  sortOrder   Int       @default(0)
  validFrom   DateTime? // seasonal pricing start
  validUntil  DateTime? // seasonal pricing end
