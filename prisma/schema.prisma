model PromoCode {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code          String                           // e.g. "SUMMER20"
  discountType  String    @default("percentage") // percentage | flat
  discountValue Float                            // 20 = 20% off, or 50 = $50 off
  maxUses       Int?                             // null = unlimited
  usedCount     Int       @default(0)
  expiresAt     DateTime?                        // null = never expires
  active        Boolean   @default(true)
  showInPortal  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  jobs          Job[]

  @@unique([userId, code])
  @@index([userId, active])
}

model PlatformPromoCode {
  id               String                    @id @default(cuid())
  code             String                    @unique
  discountType     String                    @default("percentage") // percentage | flat
  discountValue    Float
  discountDuration String                    @default("once") // once | lifetime
  noCardRequired   Boolean                   @default(false)
  validPlanTiers   String[]                  @default([]) // empty = starter + growth
  maxUses          Int?
  usedCount        Int                       @default(0)
  expiresAt        DateTime?
  active           Boolean                   @default(true)
  stripeCouponId   String?
  notes            String?                   @db.Text
  createdBy        String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  redemptions      PlatformPromoRedemption[]

  @@index([active])
}

model PlatformPromoRedemption {
  id                    String            @id @default(cuid())
