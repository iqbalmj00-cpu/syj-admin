  priceBook    PriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  name         String // "Mattress", "Appliance", "Steep Driveway"
  type         String    @default("item") // item | density | access
  amount       Float // flat dollar amount
  active       Boolean   @default(true)
  isPercentage Boolean   @default(false) // true = amount is % of subtotal
  category     String? // labour | disposal | access | material
}

model MessageTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String // display label
  channel   String   @default("sms") // sms | email
  subject   String? // email only
  body      String   @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Review {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  platform     String    @default("google") // google | yelp | internal
  reviewerName String
  rating       Int // 1–5
  body         String?   @db.Text
  replyBody    String?   @db.Text // our reply
  repliedAt    DateTime?
  templateId   String? // which template was used (no LLM)
  externalId   String? // Google review ID
  reviewedAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@index([userId, platform])
  @@index([customerId])
}

model ReviewTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String // "Positive 5-star", "Negative 1-star"
  body      String   @db.Text // template text with {{name}} placeholders
  category  String   @default("positive") // positive | negative | neutral
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Campaign {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  type        String    @default("sms") // sms | email
  status      String    @default("draft") // draft | scheduled | sent | cancelled
  subject     String? // email subject
  body        String    @db.Text // message body
  segment     Json? // filter criteria { tags:[], type:[], ... }
