model BlogPost {
  id              String       @id @default(cuid())
  agentRunId      String?
  agentRun        SyjAgentRun? @relation(fields: [agentRunId], references: [id])
  title           String
  slug            String       @unique
  metaDescription String?      @db.Text
  keywords        String[]
  content         Json                          // full blog JSON matching website schema
  excerpt         String?      @db.Text
  topic           String?
  category        String?
  tags            String[]
  wordCount       Int          @default(0)
  sources         Json?                         // [{url, title}] from Perplexity research
  status          String       @default("draft") // draft | approved | published | rejected
  target          String       @default("syj")   // "syj" = scaleyourjunk.com, "clients" = all client sites
  publishedAt     DateTime?
