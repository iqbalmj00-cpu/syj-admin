// ── Email Templates & Campaign Launches (admin cold-email console) ───────────
// Admin-only tables on the SHARED database. The authoritative migration is
// authored & pushed from the scaleyourjunk repo (it owns prisma/migrations);
// this block is the PARITY MIRROR only. No DB command was run from this repo.
// Admin code reads/writes these via raw SQL ($queryRawUnsafe/$executeRawUnsafe)
// until the operator regenerates the client AFTER the upstream push.
model EmailTemplate {
  id            String           @id @default(cuid())
  name          String
  subject       String
  bodyHtml      String           @db.Text
  bodyText      String?          @db.Text
  variablesUsed String[]                            // [bracket] variable keys used; validated vs VARIABLE_MAP at save
  isArchived    Boolean          @default(false)    // soft-delete; past launches keep their own copied sequence
  createdBy     String?                             // admin operator email
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  campaignLaunches CampaignLaunch[]
  coldEmailTemplateVersions ColdEmailTemplateVersion[]

  @@index([isArchived])
}

model CampaignLaunch {
  id                  String         @id @default(cuid())
  instantlyCampaignId String?        @unique         // set after createCampaign; null only while status=pending
  campaignName        String
  leadGroupId         String?
  leadGroup           LeadGroup?     @relation(fields: [leadGroupId], references: [id], onDelete: SetNull)
  emailTemplateId     String?
  emailTemplate       EmailTemplate? @relation(fields: [emailTemplateId], references: [id], onDelete: SetNull)
  accountEmails       String[]                       // sending mailboxes (eaccounts) chosen at launch
  status              String         @default("pending") // pending | created | active | paused | failed | archived
  attemptedCount      Int            @default(0)
  acceptedCount       Int            @default(0)
  skippedCount        Int            @default(0)
  acceptedLeadIds     String[]                       // distinct ScrapedLead ids accepted (enables distinct per-group rollups)
  skippedReasons      Json?                          // [{leadId, name, reason}]
  reContactWindowDays Int            @default(21)
  operator            String?                        // admin who launched
  error               String?        @db.Text        // failure detail when status=failed
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  canonicalCampaign   ColdEmailCampaign?

  @@index([leadGroupId])
  @@index([emailTemplateId])
  @@index([status])
}

