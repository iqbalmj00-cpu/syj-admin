  // ── Phase 1 additions ──
  autoPaymentReminders Boolean  @default(false) // enable payment reminder cron
  paymentReminderDays  Int[]    @default([3, 7, 14, 30]) // days after due to remind
  autoReEngagement     Boolean  @default(false) // enable re-engagement cron
  reEngagementMonths   Int      @default(3) // months of inactivity before re-engage
  businessHours            Json? // {mon:{open,close,closed},...sun:{...}}
  // ── 19-Feature: Status notification toggles ──
  notifyBookingConfirm     Boolean  @default(true)  // SMS on booking
  notifyDayBefore          Boolean  @default(true)  // SMS day before scheduled date
  notifyEnRoute            Boolean  @default(true)  // SMS on en_route
  notifyJobComplete        Boolean  @default(true)  // SMS on completion
  // ── Email notification toggles ──
  emailBookingConfirm      Boolean  @default(true)  // Email on booking
  emailDayBefore           Boolean  @default(true)  // Email day before scheduled date
  emailEnRoute             Boolean  @default(true)  // Email on en_route
  emailJobComplete         Boolean  @default(true)  // Email on completion
  // ── 19-Feature: Recovery discount config ──
  recoveryDiscountPercent  Int? // null = no discount, 10 = 10% off
  // ── Google Calendar sync (Starter tier) ──
  googleCalendarToken   String? // encrypted OAuth refresh token
  googleCalendarEmail   String? // connected Google account email
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model AgentConfig {
  id            String   @id @default(cuid())
