  arrCents             Int?
  currency             String?
  redactedMetadata     Json?
  occurredAt           DateTime
  projectedAt          DateTime @default(now())

  @@index([customerLinkId, occurredAt])
  @@index([opportunityId, occurredAt])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([status, occurredAt])
}

model ColdEmailManualPaymentEvidence {
  id                String   @id @default(cuid())
  idempotencyKey    String   @unique
  customerLinkId    String
  customerLink      ColdEmailCustomerLink @relation(fields: [customerLinkId], references: [id], onDelete: Cascade)
