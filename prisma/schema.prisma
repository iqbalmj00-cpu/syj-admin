  @@index([customerId])
}

model ReviewTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String // "Positive 5-star", "Negative 1-star"
  body      String   @db.Text // template text with {{name}} placeholders
  category  String   @default("positive") // positive | negative | neutral
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Campaign {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  type        String    @default("sms") // sms | email
  status      String    @default("draft") // draft | scheduled | sent | cancelled
  subject     String? // email subject
  body        String    @db.Text // message body
  segment     Json? // filter criteria { tags:[], type:[], ... }
