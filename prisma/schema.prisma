  lng       Float
  speed     Float?
  heading   Float?
  createdAt DateTime @default(now())

  @@index([truckId, createdAt])
}

// ── Phase 9C: Client Portal ──
model PortalToken {
  id         String    @id @default(cuid())
  token      String    @unique
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId     String // business owner — for scoping (Gap Fix #3)
