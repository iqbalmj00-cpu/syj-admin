# Database (same shared Neon database as the main ScaleYourJunk app)
DATABASE_URL="postgresql://..."

# Admin authentication and public base URL
NEXTAUTH_SECRET="generate-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL="your@email.com"
ADMIN_PASSWORD="your-admin-password"

# Agent control and optional external worker forwarding
AGENT_CALLBACK_SECRET="shared-agent-callback-secret"
AGENT_GATEWAY_URL="optional-agent-gateway-url"
ENRICHMENT_AGENT_URL="optional-lead-enrichment-worker-url"
COLD_OUTREACH_URL="optional-cold-outreach-worker-url"
# Set to true only after the shared DB owner migrates Lead Cleaner fields
# and the deployed admin Prisma Client includes those fields.
LEAD_CLEANER_SCHEMA_READY="false"

# AI and discovery providers
ANTHROPIC_API_KEY="anthropic-api-key"
PERPLEXITY_API_KEY="perplexity-api-key"
GEMINI_API_KEY="gemini-api-key"
OUTSCRAPER_API_KEY="outscraper-api-key"

# Vercel Blob used by generated content and research-report PDFs
BLOB_READ_WRITE_TOKEN="vercel-blob-read-write-token"

# Stripe
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Vercel website management (prefixed SYJ_ to avoid reserved names)
SYJ_VERCEL_TOKEN="vcp_..."
SYJ_VERCEL_TEAM_ID="team_..."

# Twilio phone management
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."

# Google Gmail OAuth for support replies
GOOGLE_GMAIL_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_GMAIL_CLIENT_SECRET="GOCSPX_..."

# Google Calendar OAuth for the demo scheduler
GOOGLE_CALENDAR_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CALENDAR_CLIENT_SECRET="GOCSPX_..."

# BlueBubbles iMessage/SMS bridge
BLUEBUBBLES_URL="https://your-bluebubbles-server.example"
BLUEBUBBLES_PASSWORD="bluebubbles-password"

# Email list cleaning / verification
EMAILABLE_API_KEY="live_..."

# Instantly and dormant-first canonical Cold Email controls
INSTANTLY_API_KEY="..."
INSTANTLY_CAMPAIGN_ID="optional-default-campaign-id"
INSTANTLY_WORKSPACE_ID="..."
INSTANTLY_WEBHOOK_SECRET="generate-a-random-webhook-secret"
# Optional only while rotating the webhook secret.
INSTANTLY_WEBHOOK_SECRET_PREVIOUS=""
CRON_SECRET="generate-a-random-cron-secret"

# Keep provider mutations and scheduled jobs disabled until their release gates pass.
COLD_EMAIL_CONTROL_PLANE="shadow"
COLD_EMAIL_PROVIDER_MUTATIONS_ENABLED="false"
COLD_EMAIL_AUDIENCE_PROCESSING_ENABLED="false"
COLD_EMAIL_EVENT_PROCESSING_ENABLED="false"
COLD_EMAIL_RECONCILIATION_ENABLED="false"
COLD_EMAIL_RETENTION_ENABLED="false"
COLD_EMAIL_STRIPE_PROJECTION_ENABLED="false"
COLD_EMAIL_ACCOUNT_VITALS_ENABLED="false"
COLD_EMAIL_TEST_RECIPIENTS=""
COLD_EMAIL_AI_MODEL="claude-sonnet-4-20250514"

# GitHub publishing for generated blogs and research-report fixtures
GITHUB_TOKEN="github-token"
GITHUB_REPO="owner/scaleyourjunk"
GITHUB_BRANCH="main"

# Worker-only setting: put this in the Lead Scraper / Enrichment worker .env,
# not in the deployed dashboard unless another process reads it there.
AGENT_CALLBACK_URL="https://syj-admin.vercel.app"
