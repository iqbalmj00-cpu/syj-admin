# Lead Scraper Agent — environment (copy to .env, fill in real values)

# Outscraper Maps API key. It may be shared with enrichment, but need not be.
OUTSCRAPER_API_KEY=

# Dashboard base URL + shared worker secret (same as the enrichment worker's .env).
AGENT_CALLBACK_URL=https://syj-admin.vercel.app
AGENT_CALLBACK_SECRET=

# Control-poll cadence (seconds).
POLL_INTERVAL=10

# Discovery defaults. Keep DISCOVERY_MODE=city in production; legacy ZIP helpers
# are not wired into the current provider-job control loop.
DISCOVERY_MODE=city
SEARCH_TERMS=junk removal,dumpster rental
EXPANSION_SEARCH_TERMS=roll off dumpster
BATCH_TARGET_COUNT=4
RESULTS_LIMIT=400
ENABLE_GRID_EXPANSION=true
GRID_SPACING_MILES=10
MAX_GRID_POINTS_PER_MARKET=12
GRID_MIN_POPULATION=100000
GRID_MIN_ZIP_COUNT=8
ENABLE_DROP_DUPLICATES=false
OUTSCRAPER_REGION=US
OUTSCRAPER_JOB_CONCURRENCY=3
OUTSCRAPER_POLL_INTERVAL_SECONDS=25
OUTSCRAPER_JOB_TIMEOUT_SECONDS=1800
OUTSCRAPER_LOOP_SLEEP_SECONDS=5

# Advanced optional values. Leave blank/unset unless deliberately revalidated.
# Sent as Outscraper totalLimit on each provider job when set (>0). Leave unset
# unless provider semantics and recall have been revalidated.
# TOTAL_LIMIT_PER_TARGET=
# OUTSCRAPER_FIELDS=
# OUTSCRAPER_SEARCH_URL=https://api.app.outscraper.com/maps/search-v3
# US_ZIPS_CSV=/absolute/path/to/uszips.csv
# SCRAPER_LEDGER_DB=/absolute/path/to/scraper_ledger.db

# Adaptive city-term cost guardrails.
ADAPTIVE_SECONDARY_TERMS=true
SECONDARY_TERM_SKIP_DUPLICATE_RATE=0.80
SECONDARY_TERM_SKIP_MIN_RAW_ROWS=20

# Optional safety caps. Leave 0 for full-state runs.
MAX_QUERIES_PER_RUN=0
MAX_ACCEPTED_LEADS_PER_RUN=0

# DEV ONLY — bypass the control route and sweep this state with dashboard ingest
# STUBBED (logs payloads instead of POSTing). Outscraper calls are still real and
# can consume credits. Leave unset in production.
# DRY_RUN_TARGET=MA
