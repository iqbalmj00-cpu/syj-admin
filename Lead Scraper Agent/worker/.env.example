# Lead Scraper Agent — environment (copy to .env, fill in real values)

# Outscraper API key — the SAME key the enrichment worker uses.
OUTSCRAPER_API_KEY=

# Dashboard base URL + shared worker secret (same as the enrichment worker's .env).
AGENT_CALLBACK_URL=https://syj-admin.vercel.app
AGENT_CALLBACK_SECRET=

# Control-poll cadence (seconds).
POLL_INTERVAL=10

# Discovery defaults.
DISCOVERY_MODE=city
BATCH_TARGET_COUNT=4
RESULTS_LIMIT=400
ENABLE_GRID_EXPANSION=true
GRID_SPACING_MILES=10
MAX_GRID_POINTS_PER_MARKET=12
ENABLE_DROP_DUPLICATES=false
OUTSCRAPER_JOB_CONCURRENCY=3
OUTSCRAPER_POLL_INTERVAL_SECONDS=25
OUTSCRAPER_JOB_TIMEOUT_SECONDS=1800
OUTSCRAPER_LOOP_SLEEP_SECONDS=5

# Optional safety caps. Leave 0 for full-state runs.
MAX_QUERIES_PER_RUN=0
MAX_ACCEPTED_LEADS_PER_RUN=0

# DEV ONLY — bypass the control route and sweep this state with ingest STUBBED
# (logs payloads instead of POSTing). Leave unset in production.
# DRY_RUN_TARGET=MA
